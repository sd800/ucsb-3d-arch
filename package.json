{
  "name": "ucsb-campus-model",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:viewer": "npm run build:worker && esbuild scripts/viewer.js --bundle --minify --format=iife --target=es2020 --loader:.txt=text --outfile=tmp/viewer.bundle.js",
    "build": "npm run build:viewer && python3 scripts/package_viewer.py",
    "check:3ds": "node scripts/validate_3ds.mjs output/UCSB_MainCampus.3ds",
    "check:seo": "python3 scripts/check_seo.py && node scripts/check_model_data.mjs",
    "build:worker": "esbuild scripts/model_worker.js --bundle --minify --format=iife --target=es2020 --outfile=tmp/model-worker.bundle.txt",
    "check:release": "python3 scripts/check_release.py",
    "check:interaction": "node scripts/check_interaction.mjs",
    "check:viewport": "node scripts/check_viewport.mjs",
    "check:hover": "node scripts/check_outdoor_hover.mjs",
    "check:locale": "node scripts/check_locale.mjs",
    "build:model": "node scripts/pack_web_model.mjs",
    "check:compression": "node scripts/check_compression.mjs",
    "check:ground": "node scripts/check_ground_contact.mjs",
    "check:terrain": "node scripts/check_terrain_occlusion.mjs",
    "build:terrain-check": "esbuild scripts/check_terrain_gpu.js --bundle --format=iife --target=es2020 --outfile=tmp/terrain-check.js && python3 scripts/package_terrain_check.py",
    "check:touch": "node scripts/check_touch.mjs",
    "build:stream": "python3 scripts/build_stream_model.py",
    "check:stream": "node scripts/check_stream.mjs",
    "check:highlights": "python3 scripts/check_highlights.py",
    "check:storke": "node scripts/check_storke.mjs",
    "build:highlight-review": "python3 scripts/build_highlight_review.py && esbuild scripts/highlight_review.js --bundle --format=esm --outfile=tmp/highlight-review.js",
    "check:highlight-forms": "node scripts/check_highlight_forms.mjs",
    "check:view-state": "node scripts/check_view_readout.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "meshoptimizer": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
